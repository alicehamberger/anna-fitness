{
  "rewrites": [
    { "source": "/datenschutz", "destination": "/index.html" },
    { "source": "/impressum", "destination": "/index.html" },
    { "source": "/privacy", "destination": "/index.html" },
    { "source": "/legal", "destination": "/index.html" }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        },
        { "key": "X-Robots-Tag", "value": "noindex, nofollow" }
      ]
    }
  ]
}
